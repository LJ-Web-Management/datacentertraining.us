    "/api/credentials.json": {
      "get": {
        "operationId": "getCredentials",
        "summary": "Certificate and accreditation facts",
        "description": "What the certificate of completion is and is not, with claims agents must not make.",
        "tags": [
          "Catalog data"
        ],
        "responses": {
          "200": {
            "description": "Certificate and accreditation facts",
            "content": {
              "application/json": {
                "schema": {
