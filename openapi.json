{
  "openapi": "3.1.0",
  "info": {
    "title": "Data Center Training - Public Catalog API",
    "version": "1.0.0",
    "description": "Read-only, unauthenticated JSON documents describing Data Center Training's 44 courses, 7 bundles, 6 learning tracks, roles, FAQ, credentials, and resources, plus the HTML pages they come from. The same data backs the WebMCP tools in /.well-known/mcp.json. Last updated 2026-10-08.",
    "contact": {
      "name": "HAZWOPER OSHA Training, LLC",
      "email": "info@hazwoper-osha.com",
      "url": "https://datacentertraining.us/"
    }
  },
  "servers": [
    {
      "url": "https://datacentertraining.us"
    }
  ],
  "externalDocs": {
    "description": "llms-full.txt",
    "url": "https://datacentertraining.us/llms-full.txt"
  },
  "tags": [
    {
      "name": "Catalog data",
      "description": "Static JSON documents"
    },
    {
      "name": "Agent discovery",
      "description": "Manifests and AI context files"
    },
    {
      "name": "Pages",
      "description": "Canonical HTML pages"
    }
  ],
  "paths": {
    "/api/index.json": {
      "get": {
        "operationId": "getApiIndex",
        "summary": "API index",
        "description": "Links to every JSON document, counts, content hash, and agent rules.",
        "tags": [
          "Catalog data"
        ],
        "responses": {
          "200": {
            "description": "API index",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiIndex"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/courses.json": {
      "get": {
        "operationId": "listCourses",
        "summary": "All courses",
        "description": "Every course as a full record. Filter client-side; see the list_courses tool for the documented filters.",
        "tags": [
          "Catalog data"
        ],
        "responses": {
          "200": {
            "description": "All courses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseList"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/courses/{course_id}.json": {
      "get": {
        "operationId": "getCourse",
        "summary": "One course",
        "description": "Full record for one course. Returns 404 for unknown ids.",
        "tags": [
          "Catalog data"
        ],
        "responses": {
          "200": {
            "description": "One course",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "description": "Course id (URL slug).",
            "schema": {
              "type": "string",
              "enum": [
                "data-center-design-fundamentals",
                "tier-infrastructure-fundamentals",
                "data-center-operations-management",
                "security-compliance-data-centers",
                "power-systems-electrical-fundamentals",
                "cooling-systems-design-optimization",
                "disaster-recovery-business-continuity",
                "infrastructure-commissioning-startup",
                "monitoring-automation-bms-systems",
                "hvac-troubleshooting-essentials",
                "ups-operations-load-testing",
                "fiber-optics-network-cabling",
                "generator-operations-maintenance",
                "energy-efficiency-pue-optimization",
                "capacity-planning-forecasting",
                "preventive-maintenance-planning",
                "facility-environmental-compliance",
                "incident-response-troubleshooting",
                "access-control-physical-security",
                "dcim-platform-fundamentals",
                "mechanical-systems-maintenance",
                "electrical-safety-best-practices",
                "batteries-dc-circuits",
                "building-automation-systems-fundamentals",
                "building-envelope-fundamentals",
                "building-maintenance-fundamentals",
                "business-continuity-disaster-recovery-planning",
                "data-center-arc-flash-safety",
                "data-center-cooling-refrigerant-safety",
                "data-center-electrical-safety",
                "data-center-epo-procedures",
                "data-center-fire-suppression-safety",
                "data-center-physical-security-access-control",
                "data-center-raised-floor-confined-space",
                "data-center-ups-battery-safety",
                "emergency-standby-power-systems-fundamentals",
                "facility-management-fundamentals",
                "generator-fundamentals",
                "lithium-ion-thermal-runaway-emergency-response",
                "osha-electrical-safety-data-center-technicians",
                "power-distribution-systems-fundamentals",
                "roofing-systems-maintenance-fundamentals",
                "server-room-ergonomics-manual-handling",
                "ups-systems-fundamentals"
              ]
            }
          }
        ]
      }
    },
    "/api/bundles.json": {
      "get": {
        "operationId": "listBundles",
